<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="projekt_bazy.Views.PathFindingView">

	<Grid RowDefinitions="Auto,*"
          Margin="24">

		<StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="8">

			<Button Content="Powrót"
                    Width="120"
                    Click="BackButton_Click" />

			<TextBlock x:Name="TitleTextBlock"
                       VerticalAlignment="Center"
                       FontSize="20" />
		</StackPanel>

		<ScrollViewer Grid.Row="1"
                      Margin="0,24,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

			<StackPanel Spacing="20"
                        Width="420"
                        HorizontalAlignment="Left">

				<TextBlock Text="Parametry wyszukiwania ścieżki"
                           FontSize="22" />

				<Border BorderBrush="Gray"
                        BorderThickness="1"
                        Padding="16"
                        CornerRadius="8">

					<StackPanel Spacing="10">

						<TextBlock Text="Priorytety dróg:"
                                   FontWeight="Bold" />

						<CheckBox x:Name="Priority1CheckBox"
                                  Content="1" />

						<CheckBox x:Name="Priority2CheckBox"
                                  Content="2" />

						<CheckBox x:Name="Priority3CheckBox"
                                  Content="3" />

						<CheckBox x:Name="AllPrioritiesCheckBox"
                                  Content="Wszystkie"
                                  Click="AllPrioritiesCheckBox_Click" />

					</StackPanel>

				</Border>

				<StackPanel Spacing="8">
					<TextBlock Text="Algorytm:"
                               FontWeight="Bold" />

					<ComboBox x:Name="AlgorithmComboBox"
                              Width="250"
                              SelectedIndex="0">
						<ComboBoxItem Content="Naive" />
					</ComboBox>
				</StackPanel>

				<StackPanel Spacing="8">
					<TextBlock Text="Punkt startowy:"
                               FontWeight="Bold" />

					<ComboBox x:Name="StartPointComboBox"
                              Width="250"
                              PlaceholderText="Wybierz punkt startowy" />
				</StackPanel>

				<Border BorderBrush="Gray"
        BorderThickness="1"
        Padding="16"
        CornerRadius="8">

					<StackPanel Spacing="10">

						<TextBlock Text="Ważne lokalizacje do odwiedzenia:"
								   FontWeight="Bold" />

						<StackPanel Orientation="Horizontal"
									Spacing="8">

							<ComboBox x:Name="ImportantPlaceComboBox"
									  Width="250"
									  PlaceholderText="Wybierz lokalizację" />

							<Button Content="Dodaj"
									Width="100"
									Click="AddImportantPlaceButton_Click" />

						</StackPanel>

						<TextBlock Text="Wybrane lokalizacje:" />

						<ListBox x:Name="SelectedImportantPlacesListBox"
								 Width="360"
								 MinHeight="100"
								 MaxHeight="180">

							<ListBox.ItemTemplate>
								<DataTemplate>
									<DockPanel LastChildFill="True"
											   Margin="0,4">

										<Button Content="Usuń"
												DockPanel.Dock="Right"
												Margin="8,0,0,0"
												Click="RemoveImportantPlaceButton_Click" />

										<TextBlock Text="{Binding}"
												   VerticalAlignment="Center" />

									</DockPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>

						</ListBox>

					</StackPanel>

				</Border>

				<Button Content="Aktywuj"
                        Width="160"
                        Click="ActivateButton_Click" />

				<TextBlock x:Name="StatusTextBlock"
                           TextWrapping="Wrap" />

			</StackPanel>

		</ScrollViewer>

	</Grid>
</UserControl>